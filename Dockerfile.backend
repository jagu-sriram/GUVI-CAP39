
# -----------------------------
# Stage 1: Build Spring Boot
# -----------------------------
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

COPY backend/pom.xml .
COPY backend/src ./src

RUN mvn -B -DskipTests package

# -----------------------------
# Stage 2: Java + Python runtime
# -----------------------------
FROM eclipse-temurin:21-jre-noble

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 \
       python3-venv \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create Python virtual environment
RUN python3 -m venv /opt/venv

# Install the complete ETL requirements
COPY etl/requirements.txt /tmp/requirements.txt

RUN /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

# Copy Spring Boot JAR
COPY --from=builder /build/target/*.jar /app/app.jar

# Copy ETL project
COPY etl/ /opt/cap39-etl/

# Create writable directories and non-root user
RUN mkdir -p /app/incoming /opt/cap39-etl/data/upload_runs \
    && useradd --system --uid 10001 cap39 \
    && chown -R cap39:cap39 /app /opt/cap39-etl

# Python ETL configuration
ENV CAP39_PYTHON_EXECUTABLE=/opt/venv/bin/python
ENV CAP39_PYTHON_PROJECT_DIR=/opt/cap39-etl
ENV CAP39_PYTHON_SCRIPT=/opt/cap39-etl/process_single_upload.py
ENV CAP39_ETL_RESULTS_DIR=/opt/cap39-etl/data/upload_runs
ENV CAP39_PROCESS_TIMEOUT_SECONDS=600

# AWS configuration
ENV AWS_REGION=ap-south-1
ENV CAP39_S3_BUCKET=sriram-cap39-storage

EXPOSE 8080

USER cap39

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
